# 复制为 .env 后填写；不要提交真实 .env
# 数据库（默认 SQLite，可留空）
DATABASE_URL=

# 智谱 GLM-4-Flash（留空则走模板降级）
ZHIPU_API_KEY=

# 和风天气（留空则天气走 mock）
QWEATHER_KEY=

# 对话额度
CHAT_SESSION_QUOTA=15
CHAT_COST_RECOMMEND=3
CHAT_COST_REJECT=1
CHAT_COST_KNOWLEDGE=0

# 知识库检索
KB_HYBRID_ENABLED=1
KB_SYNONYM_EXPAND=1
KB_RRF_K=60

# LLM
LLM_TIMEOUT=25
LLM_HISTORY_TURNS=6
