  usecase "管理衣物（增删改查）" as uc4
  usecase "Excel 批量导入衣物" as uc5
  usecase "上传衣物图片" as uc6
  usecase "创建对话会话" as uc7
  usecase "获取搭配推荐" as uc8
  usecase "多轮调整与单品改良" as uc9
  usecase "穿搭知识问答" as uc10
  usecase "提交反馈" as uc11
  usecase "撤销反馈" as uc12
  usecase "购前评估" as uc13
  usecase "查询历史记录" as uc14
  usecase "结束会话" as uc15
}

user --> uc1
user --> uc2
user --> uc3
user --> uc4
user --> uc5
user --> uc6
user --> uc7
user --> uc8
user --> uc9
user --> uc10
user --> uc11
user --> uc12
user --> uc13
user --> uc14
